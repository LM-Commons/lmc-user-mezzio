{
  "name": "lm-commons/lmc-user-mezzio",
  "description": "LmcUser for Mezzio",
  "license": "MIT",
  "authors": [
    {
      "name": "Eric Richer",
      "email": "eric.richer@vistoconsulting.com"
    }
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
    "laminas/laminas-servicemanager": "^3.20 || ^4.2",
    "lm-commons/lmc-user-common": "1.0.x-dev",
    "mezzio/mezzio-authentication": "^1.11",
    "psr/http-factory": "^1.0",
    "mezzio/mezzio-helpers": "^5.18",
    "mezzio/mezzio-session": "^1.16"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^11.5 || ^12.1",
    "psalm/plugin-phpunit": "^0.19",
    "vimeo/psalm": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\User\\Mezzio\\": "src/"
    }
  },
  "autoload-dev": {
    "LmcTest\\User\\Mezzio": "test/"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.99"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "Lmc\\User\\Mezzio\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats"
  },
  "repositories": [
    {
      "type": "github",
      "url": "https://github.com/lm-commons/LmcUserCommon.git"
    }
  ]
}
